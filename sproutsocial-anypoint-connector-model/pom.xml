        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <executions>
                        <execution>
                            <!-- Generate the jar with the classifier in addition to the standard jar -->
                            <id>default-mule-plugin-jar</id>
                            <goals>
                                <goal>jar</goal>
                            </goals>
                            <configuration>
                                <classifier>mule-plugin</classifier>
                                <archive>
                                    <manifestEntries>
                                        <Automatic-Module-Name>${javaModuleName}</Automatic-Module-Name>
                                    </manifestEntries>
                                </archive>
                                <outputDirectory>${project.build.directory}</outputDirectory>
                                <classesDirectory>${project.build.directory}/classes</classesDirectory>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

<!--
    NOTE: uncomment when publishing to Exchange
-->
    <distributionManagement>
        <repository>
            <id>NexGen Repository</id>
            <name>Corporate Repository</name>
            <url>https://maven.anypoint.mulesoft.com/api/v2/organizations/38760dd1-2c8c-4b2a-ba89-8ad7927e56e2/maven</url>
            <layout>default</layout>
        </repository>
    </distributionManagement>
